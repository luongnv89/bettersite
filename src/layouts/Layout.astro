---
import '../styles/global.css';
import { withBase } from '../lib/url';
import { defaultLocale, type Locale } from '../i18n';

interface Props {
  title?: string;
  description?: string;
  locale?: Locale;
}

const {
  title = 'BetterSite — Your Website, Rebuilt Better. In 48 Hours.',
  description = 'We rebuild your existing website with modern UI/UX, top SEO, bulletproof security, and lower hosting costs. See a free sample before you pay a cent.',
  locale = defaultLocale,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://luongnv89.github.io/bettersite/');
const enHref = new URL(withBase(''), Astro.site ?? 'https://luongnv89.github.io/bettersite/').toString();
const frHref = new URL(withBase('fr/'), Astro.site ?? 'https://luongnv89.github.io/bettersite/').toString();
// Per-locale 1200x630 social card, generated by scripts/generate/og-images.mjs
const ogImage = new URL(withBase(`og-${locale}.png`), Astro.site ?? 'https://luongnv89.github.io/bettersite/').toString();
---
<!doctype html>
<html lang={locale} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.toString()} />
    <link rel="alternate" hreflang="en" href={enHref} />
    <link rel="alternate" hreflang="fr" href={frHref} />
    <link rel="alternate" hreflang="x-default" href={enHref} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical.toString()} />
    <meta property="og:locale" content={locale === 'fr' ? 'fr_FR' : 'en_US'} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={title} />
    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Service",
      "name": "BetterSite",
      "description": description,
      "provider": { "@type": "Organization", "name": "BetterSite" },
      "areaServed": "Worldwide",
      "inLanguage": locale,
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "EUR", "description": "Free homepage sample, no card required" }
    })} />
    {/* Browser-language auto-redirect runs on the default-locale root only:
        an explicit /fr/ URL is itself a locale choice and must never be
        overridden (issue #18). The bs_lang cookie (language switch) and the
        once-per-session guard are unchanged. */}
    {locale === defaultLocale && (
      <script is:inline define:vars={{ frHref }}>
        (function () {
          try {
            var cookie = document.cookie.split('; ').find(function (c) { return c.indexOf('bs_lang=') === 0; });
            if (cookie) return;
            if (sessionStorage.getItem('bs_lang_detected')) return;
            sessionStorage.setItem('bs_lang_detected', '1');
            var pref = (navigator.language || 'en').toLowerCase();
            if (pref.indexOf('fr') === 0) { location.replace(frHref); return; }
          } catch (e) { /* noop */ }
        })();
      </script>
    )}
  </head>
  <body class="bg-slate-950 text-slate-100 antialiased font-sans selection:bg-emerald-400 selection:text-slate-950">
    <slot />
  </body>
</html>

<style is:global>
  :root { --bs-accent: #34d399; }
  html { font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif; }
</style>
