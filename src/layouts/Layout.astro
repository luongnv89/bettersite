---
import '../styles/global.css';
import { withBase } from '../lib/url';
import { defaultLocale, getDict, type Locale } from '../i18n';

interface Props {
  title?: string;
  description?: string;
  locale?: Locale;
  // Page path under the site base ('' for the landing pages, 'privacy/', …).
  // Drives the hreflang alternates and the EN→FR language redirect so every
  // page points at its own locale twin, never back at the landing root.
  path?: string;
}

const {
  title = 'BetterSite — Your Website, Rebuilt Better. In 48 Hours.',
  description = 'We rebuild your existing website with modern UI/UX, top SEO, bulletproof security, and lower hosting costs. See a free sample before you pay a cent.',
  locale = defaultLocale,
  path = '',
} = Astro.props;

const site = Astro.site ?? 'https://luongnv89.github.io/bettersite/';
const canonical = new URL(Astro.url.pathname, site);
const enHref = new URL(withBase(path), site).toString();
const frHref = new URL(withBase(`fr/${path}`), site).toString();
// Per-locale 1200x630 social card, generated by scripts/generate/og-images.mjs
const ogImage = new URL(withBase(`og-${locale}.png`), site).toString();
// Agent discovery (#25, #26): per-locale markdown mirrors + an llms.txt index,
// generated by scripts/generate/agent-mirrors.mjs. Real `Accept: text/markdown`
// negotiation and HTTP `Link:` headers need origin/CDN config on luongnv.com —
// these <link> tags are the deployable in-repo equivalents (RFC 8288 web links
// are valid in HTML form).
const mdEn = new URL(withBase('index.md'), site).toString();
const mdFr = new URL(withBase('fr/index.md'), site).toString();
const llmsTxt = new URL(withBase('llms.txt'), site).toString();
// Issue #37: BetterSite-scoped auth.md + RFC 9728 Protected Resource Metadata,
// shipped as static files under /bettersite/ (the origin-wide equivalents live
// on luongnv.com — see docs/origin/README.md). rel="help" is the registered
// link relation for documentation; rel="describedby" exposes the PRM JSON.
const authMd = new URL(withBase('auth.md'), site).toString();
const oauthPrm = new URL(withBase('.well-known/oauth-protected-resource'), site).toString();
// The Service entity lives at the locale's landing root regardless of which
// page embeds the JSON-LD (issue #20): url/@id equal the locale canonical.
const serviceUrl = new URL(withBase(locale === 'fr' ? 'fr/' : ''), site).toString();
const dict = getDict(locale);
---
<!doctype html>
<html lang={locale} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.toString()} />
    <link rel="alternate" hreflang="en" href={enHref} />
    <link rel="alternate" hreflang="fr" href={frHref} />
    <link rel="alternate" hreflang="x-default" href={enHref} />
    <link rel="alternate" type="text/markdown" hreflang="en" href={mdEn} />
    <link rel="alternate" type="text/markdown" hreflang="fr" href={mdFr} />
    <link rel="alternate" type="text/markdown" hreflang="x-default" href={mdEn} />
    <link rel="service-doc" type="text/plain" href={llmsTxt} />
    <link rel="describedby" type="text/plain" href={llmsTxt} />
    <link rel="help" type="text/markdown" href={authMd} />
    <link rel="describedby" type="application/json" href={oauthPrm} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical.toString()} />
    <meta property="og:locale" content={locale === 'fr' ? 'fr_FR' : 'en_US'} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={title} />
    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Service",
      "@id": serviceUrl,
      "name": "BetterSite",
      "description": description,
      "url": serviceUrl,
      "image": ogImage,
      "provider": {
        "@type": "Organization",
        "name": "BetterSite",
        "url": new URL(withBase(''), site).toString(),
        "sameAs": ["https://github.com/luongnv89/bettersite"]
      },
      "areaServed": "Worldwide",
      "inLanguage": locale,
      "offers": [
        { "@type": "Offer", "price": "0", "priceCurrency": "EUR", "url": serviceUrl, "description": dict.jsonld.offer_sample_desc },
        { "@type": "Offer", "price": dict.pricing.price_amount, "priceCurrency": "EUR", "url": `${serviceUrl}#pricing`, "description": dict.jsonld.offer_rebuild_desc }
      ]
    })} />
    {/* Browser-language auto-redirect runs on the default-locale root only:
        an explicit /fr/ URL is itself a locale choice and must never be
        overridden (issue #18). The bs_lang cookie (language switch) and the
        once-per-session guard are unchanged. */}
    {locale === defaultLocale && (
      <script is:inline define:vars={{ frHref }}>
        (function () {
          try {
            var cookie = document.cookie.split('; ').find(function (c) { return c.indexOf('bs_lang=') === 0; });
            if (cookie) return;
            if (sessionStorage.getItem('bs_lang_detected')) return;
            sessionStorage.setItem('bs_lang_detected', '1');
            var pref = (navigator.language || 'en').toLowerCase();
            if (pref.indexOf('fr') === 0) { location.replace(frHref); return; }
          } catch (e) { /* noop */ }
        })();
      </script>
    )}
  </head>
  <body class="bg-brand-cream text-brand-ink antialiased font-sans selection:bg-brand-terra selection:text-white">
    <slot />
  </body>
</html>

<style is:global>
  :root { --bs-accent: #a8432b; }
  html { font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif; }
</style>
