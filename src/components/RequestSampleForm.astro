---
import { getDict, type Locale } from '../i18n';
import { withBase } from '../lib/url';

interface Props {
  variant?: 'hero' | 'final';
  id?: string;
  locale?: Locale;
}
const { variant = 'hero', id = 'request-sample', locale = 'en' } = Astro.props;
const t = getDict(locale).form;
const accessKey = (import.meta.env.PUBLIC_WEB3FORMS_KEY ?? '').trim();
const site = Astro.site ?? 'https://luongnv89.github.io/bettersite/';
const pageUrl = new URL(withBase(locale === 'fr' ? 'fr/' : ''), site).toString();
if (accessKey === '' || accessKey === 'YOUR_WEB3FORMS_ACCESS_KEY') {
  throw new Error(
    'PUBLIC_WEB3FORMS_KEY is unset or empty. Set it in the repo secrets (CI deploy) or in .env (local dev) — refusing to build a sample-request form with a dead Web3Forms access_key.'
  );
}
// No-JS fallback: native POST to Web3Forms, then back to this page's
// confirmation block (`#{id}-sent`, revealed by :target — no JS needed).
const redirectTo = `${pageUrl}#${id}-sent`;
// Issue #24: the fineprint links to the localized privacy page.
const privacyHref = withBase(locale === 'fr' ? 'fr/privacy/' : 'privacy/');
// Issue #35: the success block offers a share path for another business — a
// mailto: draft (no recipient) works with and without JS, so it lives inside
// the :target-revealed block. The page URL rides in the prefilled body.
const shareHref =
  `mailto:?subject=${encodeURIComponent(t.share_subject)}` +
  `&body=${encodeURIComponent(`${t.share_body}\n\n${pageUrl}`)}`;
---
<form
  id={id}
  method="POST"
  action="https://api.web3forms.com/submit"
  class="w-full max-w-xl mx-auto bg-white ring-1 ring-brand-ink/10 rounded-2xl p-6 md:p-8 shadow-xl shadow-brand-ink/5 text-left"
  data-variant={variant}
  data-submit-label={t.submit}
  data-sending-label={t.sending}
  toolname={`request_sample_${variant}`}
  tooldescription={t.tool_description}
>
  <input type="hidden" name="access_key" value={accessKey} />
  <input type="hidden" name="redirect" value={redirectTo} />
  <input type="hidden" name="subject" value="New BetterSite free-sample request" />
  <input type="hidden" name="from_name" value="BetterSite Landing" />
  <input type="hidden" name="locale" value={locale} />
  <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" />

  <div class="space-y-4">
    <label class="block">
      <span class="block text-sm font-medium text-brand-body mb-1.5">{t.website_label}</span>
      <input
        type="text"
        inputmode="url"
        name="website"
        required
        placeholder={t.website_placeholder}
        autocomplete="url"
        toolparamdescription={t.website_tool_param}
        class="w-full rounded-lg bg-brand-cream ring-1 ring-brand-ink/10 focus:ring-2 focus:ring-brand-terra-dark focus:outline-none px-4 py-3 placeholder:text-brand-muted"
      />
    </label>
    <label class="block">
      <span class="block text-sm font-medium text-brand-body mb-1.5">{t.email_label}</span>
      <input
        type="email"
        name="email"
        required
        placeholder={t.email_placeholder}
        autocomplete="email"
        toolparamdescription={t.email_tool_param}
        class="w-full rounded-lg bg-brand-cream ring-1 ring-brand-ink/10 focus:ring-2 focus:ring-brand-terra-dark focus:outline-none px-4 py-3 placeholder:text-brand-muted"
      />
    </label>
    <button
      type="submit"
      class="group w-full inline-flex items-center justify-center gap-2 rounded-lg bg-brand-terra-dark hover:bg-brand-terra-deep text-white font-semibold px-6 py-3.5 transition shadow-lg shadow-brand-terra/20"
    >
      <span data-submit-text>{t.submit}</span>
      <span class="transition-transform group-hover:translate-x-0.5">→</span>
    </button>
    <p class="text-xs text-brand-muted text-center">
      {t.fineprint}{' '}
      <a href={privacyHref} class="underline decoration-brand-ink/30 underline-offset-2 hover:text-brand-ink">{t.privacy_label}</a>
    </p>
  </div>

  <div id={`${id}-sent`} class="hidden target:block mt-6 rounded-lg bg-brand-sage/10 ring-1 ring-brand-sage/30 p-4 text-sm text-brand-ink" data-success role="status">
    <strong class="block text-brand-sage mb-1">{t.success_title}</strong>
    {t.success_body}
    {/* Issue #35: share path consistent with this success block — visible on
        both the JS-revealed and the no-JS :target-revealed variants. */}
    <p class="mt-3 pt-3 border-t border-brand-sage/20 text-brand-body">
      {t.share_prompt}{' '}
      <a href={shareHref} class="font-medium text-brand-terra-dark underline decoration-brand-terra/40 underline-offset-2 hover:text-brand-terra-deep">{t.share_cta} →</a>
    </p>
  </div>
  {/* Issue #32: keep the error message's contact mailto readable through
      Cloudflare email obfuscation — the email_off markers exempt this block
      (decision record: docs/origin/README.md). */}
  <!--email_off-->
  <div class="hidden mt-6 rounded-lg bg-red-50 ring-1 ring-red-700/20 p-4 text-sm text-red-800" data-error role="alert" set:html={t.error_body} />
  <!--/email_off-->
</form>

<script>
  const forms = document.querySelectorAll<HTMLFormElement>('form[data-submit-label]');
  forms.forEach((form) => {
    if (!form.querySelector('input[name="access_key"]')) return;
    const submitLabel = form.dataset.submitLabel ?? 'Submit';
    const sendingLabel = form.dataset.sendingLabel ?? 'Sending…';
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const website = form.querySelector<HTMLInputElement>('input[name="website"]');
      if (website) {
        const raw = website.value.trim();
        website.value = raw === '' || /^[a-zA-Z][a-zA-Z0-9+.-]*:\/\//.test(raw)
          ? raw
          : `https://${raw.replace(/^\/+/, '')}`;
        if (website.value === '') {
          website.reportValidity();
          return;
        }
      }
      const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      const submitText = form.querySelector<HTMLElement>('[data-submit-text]');
      const success = form.querySelector<HTMLElement>('[data-success]');
      const error = form.querySelector<HTMLElement>('[data-error]');
      success?.classList.add('hidden');
      error?.classList.add('hidden');
      if (submit) submit.disabled = true;
      if (submitText) submitText.textContent = sendingLabel;
      try {
        const res = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify(Object.fromEntries(new FormData(form).entries())),
        });
        const data = await res.json();
        if (data.success) {
          form.reset();
          success?.classList.remove('hidden');
        } else {
          error?.classList.remove('hidden');
        }
      } catch {
        error?.classList.remove('hidden');
      } finally {
        if (submit) submit.disabled = false;
        if (submitText) submitText.textContent = submitLabel;
      }
    });
  });
</script>
