---
import { getDict, type Locale } from '../i18n';
import { withBase } from '../lib/url';

interface Props {
  variant?: 'hero' | 'final';
  id?: string;
  locale?: Locale;
}
const { variant = 'hero', id = 'request-sample', locale = 'en' } = Astro.props;
const t = getDict(locale).form;
const accessKey = (import.meta.env.PUBLIC_WEB3FORMS_KEY ?? '').trim();
if (accessKey === '' || accessKey === 'YOUR_WEB3FORMS_ACCESS_KEY') {
  throw new Error(
    'PUBLIC_WEB3FORMS_KEY is unset or empty. Set it in the repo secrets (CI deploy) or in .env (local dev) — refusing to build a sample-request form with a dead Web3Forms access_key.'
  );
}
// No-JS fallback: native POST to Web3Forms, then back to this page's
// confirmation block (`#{id}-sent`, revealed by :target — no JS needed).
const redirectTo = new URL(
  `${withBase(locale === 'fr' ? 'fr/' : '')}#${id}-sent`,
  Astro.site ?? 'https://luongnv89.github.io/bettersite/'
).toString();
// Issue #24: the fineprint links to the localized privacy page.
const privacyHref = withBase(locale === 'fr' ? 'fr/privacy/' : 'privacy/');
---
<form
  id={id}
  method="POST"
  action="https://api.web3forms.com/submit"
  class="w-full max-w-xl mx-auto bg-slate-900/60 backdrop-blur ring-1 ring-white/10 rounded-2xl p-6 md:p-8 shadow-2xl"
  data-variant={variant}
  data-submit-label={t.submit}
  data-sending-label={t.sending}
>
  <input type="hidden" name="access_key" value={accessKey} />
  <input type="hidden" name="redirect" value={redirectTo} />
  <input type="hidden" name="subject" value="New BetterSite free-sample request" />
  <input type="hidden" name="from_name" value="BetterSite Landing" />
  <input type="hidden" name="locale" value={locale} />
  <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" />

  <div class="space-y-4">
    <label class="block">
      <span class="block text-sm font-medium text-slate-300 mb-1.5">{t.website_label}</span>
      <input
        type="text"
        inputmode="url"
        name="website"
        required
        placeholder={t.website_placeholder}
        autocomplete="url"
        class="w-full rounded-lg bg-slate-950/60 ring-1 ring-white/10 focus:ring-2 focus:ring-emerald-400 focus:outline-none px-4 py-3 placeholder:text-slate-400"
      />
    </label>
    <label class="block">
      <span class="block text-sm font-medium text-slate-300 mb-1.5">{t.email_label}</span>
      <input
        type="email"
        name="email"
        required
        placeholder={t.email_placeholder}
        autocomplete="email"
        class="w-full rounded-lg bg-slate-950/60 ring-1 ring-white/10 focus:ring-2 focus:ring-emerald-400 focus:outline-none px-4 py-3 placeholder:text-slate-400"
      />
    </label>
    <button
      type="submit"
      class="group w-full inline-flex items-center justify-center gap-2 rounded-lg bg-emerald-400 hover:bg-emerald-300 text-slate-950 font-semibold px-6 py-3.5 transition shadow-lg shadow-emerald-500/20"
    >
      <span data-submit-text>{t.submit}</span>
      <span class="transition-transform group-hover:translate-x-0.5">→</span>
    </button>
    <p class="text-xs text-slate-400 text-center">
      {t.fineprint}{' '}
      <a href={privacyHref} class="underline decoration-slate-600 underline-offset-2 hover:text-slate-300">{t.privacy_label}</a>
    </p>
  </div>

  <div id={`${id}-sent`} class="hidden target:block mt-6 rounded-lg bg-emerald-400/10 ring-1 ring-emerald-400/30 p-4 text-sm text-emerald-200" data-success role="status">
    <strong class="block text-emerald-100 mb-1">{t.success_title}</strong>
    {t.success_body}
  </div>
  <div class="hidden mt-6 rounded-lg bg-rose-400/10 ring-1 ring-rose-400/30 p-4 text-sm text-rose-200" data-error role="alert" set:html={t.error_body} />
</form>

<script>
  const forms = document.querySelectorAll<HTMLFormElement>('form[data-submit-label]');
  forms.forEach((form) => {
    if (!form.querySelector('input[name="access_key"]')) return;
    const submitLabel = form.dataset.submitLabel ?? 'Submit';
    const sendingLabel = form.dataset.sendingLabel ?? 'Sending…';
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const website = form.querySelector<HTMLInputElement>('input[name="website"]');
      if (website) {
        const raw = website.value.trim();
        website.value = raw === '' || /^[a-zA-Z][a-zA-Z0-9+.-]*:\/\//.test(raw)
          ? raw
          : `https://${raw.replace(/^\/+/, '')}`;
        if (website.value === '') {
          website.reportValidity();
          return;
        }
      }
      const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      const submitText = form.querySelector<HTMLElement>('[data-submit-text]');
      const success = form.querySelector<HTMLElement>('[data-success]');
      const error = form.querySelector<HTMLElement>('[data-error]');
      success?.classList.add('hidden');
      error?.classList.add('hidden');
      if (submit) submit.disabled = true;
      if (submitText) submitText.textContent = sendingLabel;
      try {
        const res = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify(Object.fromEntries(new FormData(form).entries())),
        });
        const data = await res.json();
        if (data.success) {
          form.reset();
          success?.classList.remove('hidden');
        } else {
          error?.classList.remove('hidden');
        }
      } catch {
        error?.classList.remove('hidden');
      } finally {
        if (submit) submit.disabled = false;
        if (submitText) submitText.textContent = submitLabel;
      }
    });
  });
</script>
