---
import Layout from '../layouts/Layout.astro';
import RequestSampleForm from './RequestSampleForm.astro';
import LangSwitcher from './LangSwitcher.astro';
import { withBase } from '../lib/url';
import { getDict, type Locale } from '../i18n';
import demoStats from '../../assets/demo/stats.json';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getDict(locale);
const privacyHref = withBase(locale === 'fr' ? 'fr/privacy/' : 'privacy/');
---
<Layout
  locale={locale}
  title={t.meta.title}
  description={t.meta.description}
>
  <header class="sticky top-0 z-40 backdrop-blur bg-slate-950/70 border-b border-white/5">
    <div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between gap-4">
      <a href="#top" class="flex items-center gap-2 font-bold tracking-tight" aria-label="BetterSite home">
        <img src={withBase('logo-mark.svg')} alt="" width="28" height="28" class="w-7 h-7" />
        <span>Better<span class="text-emerald-400">Site</span></span>
      </a>
      <nav class="hidden md:flex items-center gap-8 text-sm text-slate-300">
        <a href="#how" class="hover:text-white">{t.nav.how}</a>
        <a href="#proof" class="hover:text-white">{t.nav.results}</a>
        <a href="#samples" class="hover:text-white">{t.nav.samples}</a>
        <a href="#faq" class="hover:text-white">{t.nav.faq}</a>
        <a href="#pricing" class="hover:text-white">{t.nav.pricing}</a>
      </nav>
      <div class="flex items-center gap-4">
        <LangSwitcher current={locale} />
        <a href="#request" class="rounded-lg bg-emerald-400 hover:bg-emerald-300 text-slate-950 text-sm font-semibold px-4 py-2 transition">
          {t.nav.cta}
        </a>
      </div>
    </div>
    {/* Mobile section nav (#23): the desktop nav above is `hidden md:flex`, so
        below 768 px this sticky anchor strip is the only way to reach the
        page sections. Kept inside the sticky header so it stays reachable at
        any scroll depth; overflow-x-auto keeps 320 px viewports safe. */}
    <nav class="md:hidden border-t border-white/5" aria-label={t.nav.sections}>
      <div class="max-w-6xl mx-auto px-6 h-11 flex items-center gap-6 overflow-x-auto text-sm text-slate-300">
        <a href="#how" class="h-full inline-flex items-center whitespace-nowrap hover:text-white">{t.nav.how}</a>
        <a href="#proof" class="h-full inline-flex items-center whitespace-nowrap hover:text-white">{t.nav.results}</a>
        <a href="#samples" class="h-full inline-flex items-center whitespace-nowrap hover:text-white">{t.nav.samples}</a>
        <a href="#faq" class="h-full inline-flex items-center whitespace-nowrap hover:text-white">{t.nav.faq}</a>
        <a href="#pricing" class="h-full inline-flex items-center whitespace-nowrap hover:text-white">{t.nav.pricing}</a>
      </div>
    </nav>
  </header>

  <section id="top" class="relative overflow-hidden">
    <div class="absolute inset-0 -z-10">
      <div class="absolute -top-40 -left-40 w-[40rem] h-[40rem] rounded-full bg-emerald-500/20 blur-3xl"></div>
      <div class="absolute top-40 -right-40 w-[40rem] h-[40rem] rounded-full bg-cyan-500/10 blur-3xl"></div>
    </div>
    <div class="max-w-6xl mx-auto px-6 pt-20 pb-12 md:pt-28 md:pb-16 grid lg:grid-cols-2 gap-12 items-center">
      <div>
        <span class="inline-flex items-center gap-2 rounded-full bg-emerald-400/10 ring-1 ring-emerald-400/30 text-emerald-300 text-xs font-medium px-3 py-1 mb-6">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
          {t.hero.badge}
        </span>
        <h1 class="text-4xl md:text-6xl font-bold tracking-tight leading-[1.05]">
          {t.hero.title_1}
          <span class="bg-gradient-to-r from-emerald-300 to-cyan-300 bg-clip-text text-transparent">{t.hero.title_highlight}</span>
          {t.hero.title_2}
        </h1>
        <p class="mt-6 text-lg md:text-xl text-slate-300 max-w-xl">{t.hero.subtitle}</p>
        <div class="mt-8 flex flex-wrap items-center gap-4 text-sm text-slate-400">
          {t.hero.bullets.map((b) => <span class="flex items-center gap-2">✓ {b}</span>)}
        </div>
      </div>
      <div id="request" class="lg:justify-self-end w-full scroll-mt-32 md:scroll-mt-24">
        <RequestSampleForm variant="hero" id="form-hero" locale={locale} />
      </div>
    </div>
    <div class="max-w-6xl mx-auto px-6 pb-20 md:pb-28">
      <a href="#samples" class="block rounded-2xl bg-slate-900/60 ring-1 ring-white/10 p-5 md:p-6 hover:ring-emerald-400/30 transition group">
        <div class="flex flex-wrap items-baseline justify-between gap-2 mb-4">
          <p class="text-sm font-semibold text-white">{t.demo.title}</p>
          <span class="text-xs font-medium text-emerald-300 group-hover:underline">{t.demo.link} →</span>
        </div>
        <div class="grid sm:grid-cols-2 gap-4">
          <figure class="relative">
            <img
              src={withBase('demo/before.png')}
              alt={t.samples.before_alt}
              width="1280"
              height="800"
              loading="eager"
              decoding="async"
              class="w-full rounded-lg ring-1 ring-white/10"
            />
            <figcaption class="absolute top-2 left-2 rounded-md bg-slate-950/85 px-2 py-1 text-xs font-medium text-slate-300 ring-1 ring-white/10">{t.demo.before_label}</figcaption>
          </figure>
          <figure class="relative">
            <img
              src={withBase('demo/after.png')}
              alt={t.samples.after_alt}
              width="1280"
              height="800"
              loading="eager"
              decoding="async"
              class="w-full rounded-lg ring-1 ring-white/10"
            />
            <figcaption class="absolute top-2 left-2 rounded-md bg-emerald-400/90 px-2 py-1 text-xs font-semibold text-slate-950">{t.demo.after_label}</figcaption>
          </figure>
        </div>
        <p class="mt-4 text-xs text-slate-400">
          {t.demo.caption}
          <span class="text-slate-300 font-medium">
            {demoStats.before.domNodes} → {demoStats.after.domNodes} {t.demo.stat_nodes}
            · {demoStats.before.htmlKb} → {demoStats.after.htmlKb} KB {t.demo.stat_weight}
          </span>
        </p>
      </a>
    </div>
  </section>

  <section class="border-t border-white/5 bg-slate-950">
    <div class="max-w-4xl mx-auto px-6 py-20 md:py-28">
      <h2 class="text-3xl md:text-5xl font-bold tracking-tight">{t.problem.title}</h2>
      <p class="mt-6 text-lg text-slate-300">{t.problem.lead}</p>
      <ul class="mt-8 space-y-3 text-slate-300">
        {t.problem.items.map((item) => (
          <li class="flex gap-3"><span class="text-rose-400">✗</span> {item}</li>
        ))}
      </ul>
      <p class="mt-8 text-xl font-semibold text-white">{t.problem.punchline}</p>
    </div>
  </section>

  <section class="border-t border-white/5 bg-gradient-to-b from-slate-950 to-slate-900">
    <div class="max-w-6xl mx-auto px-6 py-20 md:py-28">
      <div class="max-w-3xl">
        <h2 class="text-3xl md:text-5xl font-bold tracking-tight">{t.solution.title}</h2>
        <p class="mt-6 text-lg text-slate-300">{t.solution.lead}</p>
      </div>
      <div class="mt-14 grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {t.features.map((f) => (
          <div class="rounded-2xl bg-slate-900/60 ring-1 ring-white/10 p-6 hover:ring-emerald-400/30 transition">
            <div class="text-3xl mb-3">{f.icon}</div>
            <h3 class="text-lg font-semibold">{f.title}</h3>
            <p class="mt-2 text-slate-400 text-sm leading-relaxed">{f.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="how" class="border-t border-white/5 bg-slate-950 scroll-mt-32 md:scroll-mt-24">
    <div class="max-w-6xl mx-auto px-6 py-20 md:py-28">
      <div class="max-w-3xl">
        <h2 class="text-3xl md:text-5xl font-bold tracking-tight">{t.how.title}</h2>
        <p class="mt-6 text-lg text-slate-300">{t.how.lead}</p>
      </div>
      <ol class="mt-14 grid md:grid-cols-2 lg:grid-cols-4 gap-6">
        {t.steps.map((s) => (
          <li class="rounded-2xl bg-slate-900/60 ring-1 ring-white/10 p-6">
            <div class="text-emerald-400 font-mono text-sm mb-3">{s.n}</div>
            <h3 class="text-lg font-semibold">{s.title}</h3>
            <p class="mt-2 text-slate-400 text-sm leading-relaxed">{s.body}</p>
          </li>
        ))}
      </ol>
      <div class="mt-12 text-center">
        <a href="#request" class="inline-flex items-center gap-2 rounded-lg bg-emerald-400 hover:bg-emerald-300 text-slate-950 font-semibold px-6 py-3 transition">
          {t.how.cta} <span>→</span>
        </a>
      </div>
    </div>
  </section>

  <section id="proof" class="border-t border-white/5 bg-gradient-to-b from-slate-900 to-slate-950 scroll-mt-32 md:scroll-mt-24">
    <div class="max-w-6xl mx-auto px-6 py-20 md:py-28">
      <h2 class="text-3xl md:text-5xl font-bold tracking-tight">{t.proof.title}</h2>
      <div class="mt-12 grid grid-cols-2 lg:grid-cols-4 gap-6">
        {t.proof.metrics.map((m) => (
          <div class="rounded-2xl bg-slate-900/60 ring-1 ring-white/10 p-6 text-center">
            <div class="text-3xl md:text-4xl font-bold bg-gradient-to-r from-emerald-300 to-cyan-300 bg-clip-text text-transparent">{m.value}</div>
            <div class="mt-2 text-sm text-slate-400">{m.label}</div>
            <div class="mt-2 text-xs leading-snug text-slate-500">{m.source}</div>
          </div>
        ))}
      </div>
      <p class="mt-6 text-xs text-slate-500">
        {t.proof.audit_note}{' '}
        <a
          href="https://github.com/luongnv89/bettersite/tree/main/docs/audits/2026-10-09"
          class="underline decoration-slate-600 underline-offset-2 hover:text-slate-300"
        >{t.proof.audit_link}</a>
      </p>
      <div class="mt-12">
        <h3 class="text-xl md:text-2xl font-semibold tracking-tight">{t.proof.compare.title}</h3>
        <p class="mt-2 text-sm text-slate-400">{t.proof.compare.lead}</p>
        <div class="mt-6 overflow-x-auto rounded-2xl ring-1 ring-white/10">
          <table class="w-full min-w-[36rem] text-sm text-left">
            <thead>
              <tr class="bg-slate-900/80">
                <th scope="col" class="px-4 py-3 font-medium text-slate-500"></th>
                {t.proof.compare.columns.map((c, i) => (
                  <th
                    scope="col"
                    class:list={["px-4 py-3 font-semibold", i === 0 ? "text-emerald-300" : "text-slate-300"]}
                  >{c}</th>
                ))}
              </tr>
            </thead>
            <tbody class="divide-y divide-white/5 bg-slate-900/40">
              {t.proof.compare.rows.map((r) => (
                <tr>
                  <th scope="row" class="px-4 py-3 font-medium text-slate-200">{r.label}</th>
                  {r.cells.map((cell, i) => (
                    <td class:list={["px-4 py-3", i === 0 ? "text-emerald-200" : "text-slate-400"]}>{cell}</td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>

  <section id="samples" class="border-t border-white/5 bg-slate-950 scroll-mt-32 md:scroll-mt-24">
    <div class="max-w-6xl mx-auto px-6 py-20 md:py-28">
      <div class="max-w-3xl">
        <h2 class="text-3xl md:text-5xl font-bold tracking-tight">{t.samples.title}</h2>
        <p class="mt-6 text-lg text-slate-300">{t.samples.lead}</p>
      </div>
      <div class="mt-14 grid lg:grid-cols-[2fr_1fr] gap-6 items-start">
        <div class="rounded-2xl bg-slate-900/60 ring-1 ring-white/10 p-5 md:p-6">
          <h3 class="text-lg font-semibold">{t.samples.item_title}</h3>
          <div class="mt-4 grid sm:grid-cols-2 gap-4">
            <figure class="relative">
              <img
                src={withBase('demo/before.png')}
                alt={t.samples.before_alt}
                width="1280"
                height="800"
                loading="lazy"
                class="w-full rounded-lg ring-1 ring-white/10"
              />
              <figcaption class="absolute top-2 left-2 rounded-md bg-slate-950/85 px-2 py-1 text-xs font-medium text-slate-300 ring-1 ring-white/10">{t.demo.before_label}</figcaption>
            </figure>
            <figure class="relative">
              <img
                src={withBase('demo/after.png')}
                alt={t.samples.after_alt}
                width="1280"
                height="800"
                loading="lazy"
                class="w-full rounded-lg ring-1 ring-white/10"
              />
              <figcaption class="absolute top-2 left-2 rounded-md bg-emerald-400/90 px-2 py-1 text-xs font-semibold text-slate-950">{t.demo.after_label}</figcaption>
            </figure>
          </div>
          <p class="mt-4 text-sm text-slate-400">{t.samples.item_desc}</p>
          <dl class="mt-4 grid grid-cols-2 gap-4">
            <div class="rounded-lg bg-slate-950/50 ring-1 ring-white/5 p-3">
              <dt class="text-xs text-slate-500">{t.samples.stat_nodes}</dt>
              <dd class="mt-1 text-sm font-semibold text-white">{demoStats.before.domNodes} → {demoStats.after.domNodes}</dd>
            </div>
            <div class="rounded-lg bg-slate-950/50 ring-1 ring-white/5 p-3">
              <dt class="text-xs text-slate-500">{t.samples.stat_weight}</dt>
              <dd class="mt-1 text-sm font-semibold text-white">{demoStats.before.htmlKb} KB → {demoStats.after.htmlKb} KB</dd>
            </div>
          </dl>
          <p class="mt-3 text-xs text-slate-500">
            {t.samples.stat_measured} · {demoStats.generatedAt.slice(0, 10)} · {demoStats.viewport}
          </p>
        </div>
        <div class="rounded-2xl bg-emerald-400/10 ring-1 ring-emerald-400/30 p-6">
          <h3 class="text-lg font-semibold text-emerald-200">{t.samples.cta_title}</h3>
          <p class="mt-2 text-sm text-emerald-100/80 leading-relaxed">{t.samples.cta_body}</p>
          <a href="#request" class="mt-4 inline-flex items-center gap-2 rounded-lg bg-emerald-400 hover:bg-emerald-300 text-slate-950 text-sm font-semibold px-5 py-2.5 transition">
            {t.samples.cta_link} <span>→</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section id="faq" class="border-t border-white/5 bg-slate-950 scroll-mt-32 md:scroll-mt-24">
    <div class="max-w-3xl mx-auto px-6 py-20 md:py-28">
      <h2 class="text-3xl md:text-5xl font-bold tracking-tight">{t.faq.title}</h2>
      <div class="mt-12 divide-y divide-white/5 rounded-2xl bg-slate-900/40 ring-1 ring-white/10">
        {t.faq.items.map((item) => (
          <details class="group p-6">
            <summary class="cursor-pointer list-none flex justify-between items-start gap-4">
              <span class="font-semibold">{item.q}</span>
              <span class="text-emerald-400 transition group-open:rotate-45 text-2xl leading-none">+</span>
            </summary>
            <p class="mt-3 text-slate-400 leading-relaxed">{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section id="pricing" class="border-t border-white/5 bg-gradient-to-b from-slate-950 to-slate-900 scroll-mt-32 md:scroll-mt-24">
    <div class="max-w-4xl mx-auto px-6 py-20 md:py-28">
      <h2 class="text-3xl md:text-5xl font-bold tracking-tight">{t.pricing.title}</h2>
      <p class="mt-6 text-lg text-slate-300">{t.pricing.lead}</p>
      <div class="mt-10 rounded-2xl bg-slate-900/60 ring-1 ring-white/10 p-6 md:p-8">
        <div class="flex flex-wrap items-baseline justify-between gap-4">
          <h3 class="text-lg font-semibold">{t.pricing.price_label}</h3>
          <p class="flex items-baseline gap-2">
            <span class="text-4xl md:text-5xl font-bold bg-gradient-to-r from-emerald-300 to-cyan-300 bg-clip-text text-transparent">{t.pricing.price}</span>
            <span class="text-sm text-slate-400">{t.pricing.price_note}</span>
          </p>
        </div>
        <ul class="mt-6 space-y-3 text-slate-300">
          {t.pricing.includes.map((item) => (
            <li class="flex gap-3"><span class="text-emerald-400">✓</span> {item}</li>
          ))}
        </ul>
        <p class="mt-6 text-sm leading-relaxed text-slate-400 border-t border-white/5 pt-5">{t.pricing.maintenance}</p>
        <a href="#request" class="mt-6 inline-flex items-center gap-2 rounded-lg bg-emerald-400 hover:bg-emerald-300 text-slate-950 text-sm font-semibold px-5 py-2.5 transition">
          {t.pricing.cta} <span>→</span>
        </a>
      </div>
    </div>
  </section>

  <section class="border-t border-white/5 bg-gradient-to-b from-slate-900 to-slate-950">
    <div class="max-w-4xl mx-auto px-6 py-20 md:py-28 text-center">
      <h2 class="text-3xl md:text-5xl font-bold tracking-tight">{t.final.title}</h2>
      <p class="mt-6 text-lg text-slate-300 max-w-2xl mx-auto">{t.final.lead}</p>
      <p class="mt-4 text-sm text-slate-400">{t.final.fineprint}</p>
      {/* Founder block (#22): a named human stands behind the 48 h promise,
          right where the visitor is asked to trust the form. */}
      <p class="mt-12 text-sm font-semibold uppercase tracking-wider text-slate-500">{t.founder.title}</p>
      <div class="mt-4 max-w-xl mx-auto rounded-2xl bg-slate-900/60 ring-1 ring-white/10 p-6 text-left flex items-start gap-4">
        <img
          src={withBase('founder.jpg')}
          alt={t.founder.photo_alt}
          width="64"
          height="64"
          loading="lazy"
          decoding="async"
          class="w-16 h-16 rounded-full ring-1 ring-white/10 shrink-0"
        />
        <div>
          <p class="font-semibold text-white">
            {t.founder.name}
            <span class="font-normal text-slate-400"> · {t.founder.role}</span>
          </p>
          <p class="mt-2 text-sm text-slate-400 leading-relaxed">{t.founder.story}</p>
          <a href="https://github.com/luongnv89" class="mt-2 inline-block text-xs font-medium text-emerald-300 hover:underline">{t.founder.github}</a>
        </div>
      </div>
      <div class="mt-10">
        <RequestSampleForm variant="final" id="form-final" locale={locale} />
      </div>
    </div>
  </section>

  <footer class="border-t border-white/5 bg-slate-950">
    <div class="max-w-6xl mx-auto px-6 py-10 flex flex-col md:flex-row items-center justify-between gap-4 text-sm text-slate-400">
      <div class="flex items-center gap-2">
        <img src={withBase('logo-mark.svg')} alt="" width="20" height="20" class="w-5 h-5 opacity-80" />
        <span>© {new Date().getFullYear()} BetterSite. {t.footer.tagline}</span>
      </div>
      <div class="flex items-center gap-6">
        <LangSwitcher current={locale} />
        <a href={privacyHref} class="hover:text-white">{t.footer.privacy}</a>
        {/* Issue #32: Cloudflare Email Address Obfuscation (Scrape Shield) rewrites
            this contact address at the luongnv.com edge, hiding it from no-JS
            readers and agents. The documented email_off markers exempt it —
            see docs/origin/README.md for the recorded decision. */}
        <!--email_off-->
        <a href="mailto:hello@bettersite.dev" class="hover:text-white">hello@bettersite.dev</a>
        <!--/email_off-->
        <a href="https://github.com/luongnv89/bettersite" class="hover:text-white">{t.footer.github}</a>
      </div>
    </div>
  </footer>
</Layout>
