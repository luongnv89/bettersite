---
// Public brand identity page (EN /brand/, FR /fr/brand/), linked from the
// landing footer. Logo files are served from public/brand/ — copies of the
// canonical set in assets/logo/ (see assets/logo/brand-showcase.html).
import Layout from '../layouts/Layout.astro';
import LangSwitcher from './LangSwitcher.astro';
import { withBase } from '../lib/url';
import { getDict, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getDict(locale);
const b = t.brand;
const home = withBase(locale === 'fr' ? 'fr/' : '');

// Canonical mark geometry — identical to assets/logo/logo-mark.svg.
const OLD = 'M16,8 H34 A11,11 0 0 1 34,30 H16 A3,3 0 0 1 13,27 V11 A3,3 0 0 1 16,8 Z M18,13 H34 A6,6 0 0 1 34,25 H18 Z';
const LINE = 'M21,17 H29 A2,2 0 0 1 29,21 H21 A2,2 0 0 1 21,17 Z';
const NEW = 'M16,34 H40 A11,11 0 0 1 40,56 H16 A3,3 0 0 1 13,53 V37 A3,3 0 0 1 16,34 Z';
// Concept legend: each row highlights one part of the mark, dims the others.
const parts = [OLD, LINE, NEW];

const cardBg: Record<string, string> = {
  light: 'bg-white ring-1 ring-brand-ink/10',
  sand: 'bg-brand-sand ring-1 ring-brand-ink/5',
  navy: 'bg-brand-ink',
  accent: 'bg-brand-terra-dark',
};
const label = 'text-xs font-semibold uppercase tracking-[0.2em] text-brand-terra-dark';
---
<Layout locale={locale} path="brand/" title={b.meta_title} description={b.meta_description}>
  <main>
    <div class="max-w-6xl mx-auto px-6 pt-10 flex items-center justify-between gap-4">
      <a href={home} class="inline-flex items-center gap-2 text-sm text-brand-muted hover:text-brand-ink transition">
        <span aria-hidden="true">←</span> {b.back}
      </a>
      <LangSwitcher current={locale} path="brand/" />
    </div>

    <section class="max-w-6xl mx-auto px-6 pt-14 pb-20 md:pt-20 md:pb-28 text-center">
      <p class={label}>{b.eyebrow}</p>
      <img src={withBase('brand/logo-full.svg')} alt="BetterSite" width="480" height="108" class="mx-auto mt-10 w-full max-w-[480px] h-auto" />
      <h1 class="mt-12 text-3xl md:text-5xl font-bold tracking-tight">{b.title}</h1>
      <p class="mt-6 max-w-2xl mx-auto text-lg text-brand-body">{b.lead}</p>
    </section>

    <section class="border-t border-brand-ink/10 bg-brand-sand">
      <div class="max-w-6xl mx-auto px-6 py-20 md:py-28 grid md:grid-cols-2 gap-12 items-center">
        <div class="rounded-3xl bg-brand-cream ring-1 ring-brand-ink/10 p-10 md:p-14 flex items-center justify-center">
          <svg viewBox="0 0 64 64" class="w-48 md:w-64 h-auto" role="img" aria-label="BetterSite mark">
            <path d={OLD} fill="#8a8178" fill-rule="evenodd" />
            <path d={LINE} fill="#8a8178" />
            <path d={NEW} fill="#c2553a" />
          </svg>
        </div>
        <div>
          <p class={label}>{b.concept_label}</p>
          <h2 class="mt-3 text-3xl md:text-4xl font-bold tracking-tight">{b.concept_title}</h2>
          <ol class="mt-8 space-y-5">
            {b.concept_parts.map((p, i) => (
              <li class="flex gap-4">
                <svg viewBox="0 0 64 64" class="w-11 h-11 shrink-0 rounded-lg bg-brand-cream ring-1 ring-brand-ink/10 p-1.5" aria-hidden="true">
                  {parts.map((d, j) => (
                    <path d={d} fill={j === 2 ? '#c2553a' : '#8a8178'} fill-rule="evenodd" opacity={j === i ? 1 : 0.15} />
                  ))}
                </svg>
                <div>
                  <h3 class="font-semibold"><span class="text-brand-terra-dark font-mono text-sm mr-2">{p.n}</span>{p.h}</h3>
                  <p class="mt-1 text-sm text-brand-muted leading-relaxed">{p.body}</p>
                </div>
              </li>
            ))}
          </ol>
          <p class="mt-8 text-brand-body leading-relaxed">{b.concept_body}</p>
        </div>
      </div>
    </section>

    <section class="border-t border-brand-ink/10 bg-brand-cream">
      <div class="max-w-6xl mx-auto px-6 py-20 md:py-28">
        <p class={label}>{b.variants_label}</p>
        <h2 class="mt-3 text-3xl md:text-4xl font-bold tracking-tight">{b.variants_title}</h2>
        <p class="mt-4 text-brand-muted">{b.variants_note}</p>
        <ul class="mt-12 grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {b.variants.map((v) => (
            <li class:list={['flex flex-col', v.wide ? 'sm:col-span-2 lg:col-span-4' : '']}>
              <div class:list={['rounded-2xl flex items-center justify-center p-8', v.wide ? 'h-40 md:h-48' : 'h-40', cardBg[v.bg]]}>
                <img
                  src={withBase(`brand/${v.file}`)}
                  alt={`${v.name} — BetterSite`}
                  class:list={[v.wide ? 'h-16 md:h-20 w-auto' : v.file === 'favicon.svg' ? 'w-16 h-16' : 'h-20 w-auto max-w-full']}
                />
              </div>
              <div class="mt-3 flex items-start justify-between gap-4 text-sm">
                <div>
                  <p class="font-semibold">{v.name}</p>
                  <p class="text-brand-muted">{v.use}</p>
                </div>
                <a href={withBase(`brand/${v.file}`)} download class="shrink-0 inline-flex items-center gap-1 py-1 font-mono text-xs text-brand-terra-dark hover:text-brand-terra-deep">
                  {v.file} <span aria-hidden="true">↓</span><span class="sr-only">{b.download}</span>
                </a>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="border-t border-brand-ink/10 bg-brand-sand">
      <div class="max-w-6xl mx-auto px-6 py-20 md:py-28">
        <p class={label}>{b.palette_label}</p>
        <h2 class="mt-3 text-3xl md:text-4xl font-bold tracking-tight">{b.palette_title}</h2>
        <ul class="mt-12 grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
          {b.palette.map((c) => (
            <li class="rounded-2xl bg-white ring-1 ring-brand-ink/10 overflow-hidden">
              <div class="h-24 ring-1 ring-inset ring-brand-ink/10" style={`background:${c.hex}`}></div>
              <div class="p-4">
                <p class="font-semibold">{c.name}</p>
                <p class="font-mono text-xs text-brand-muted">{c.hex}</p>
                <p class="mt-2 text-xs text-brand-muted leading-relaxed">{c.role}</p>
              </div>
            </li>
          ))}
        </ul>
        <p class="mt-8 max-w-3xl text-brand-body">{b.palette_note}</p>
      </div>
    </section>

    <section class="border-t border-brand-ink/10 bg-brand-cream">
      <div class="max-w-6xl mx-auto px-6 py-20 md:py-28 grid md:grid-cols-2 gap-12">
        <div>
          <p class={label}>{b.type_label}</p>
          <h2 class="mt-3 text-3xl md:text-4xl font-bold tracking-tight">{b.type_title}</h2>
          <div class="mt-8 rounded-2xl bg-white ring-1 ring-brand-ink/10 p-8 flex items-center justify-center">
            <img src={withBase('brand/logo-wordmark.svg')} alt="BetterSite" width="270" height="60" class="w-full max-w-[270px] h-auto" />
          </div>
          <p class="mt-6 text-brand-body leading-relaxed">{b.type_body}</p>
        </div>
        <div>
          <p class={label}>{b.rules_label}</p>
          <h2 class="mt-3 text-3xl md:text-4xl font-bold tracking-tight">{b.rules_title}</h2>
          <ul class="mt-8 space-y-4 text-brand-body">
            {b.rules.map((r) => (
              <li class="flex gap-3"><span class="text-brand-sage" aria-hidden="true">✓</span> {r}</li>
            ))}
          </ul>
          {/* Issue #32: keep the contact address readable behind Cloudflare
              email obfuscation (see docs/origin/README.md). */}
          <!--email_off-->
          <p class="mt-10 text-sm text-brand-muted">
            {b.contact} <a href="mailto:bettersite@luongnv.com" class="text-brand-terra-dark hover:text-brand-terra-deep">bettersite@luongnv.com</a>
          </p>
          <!--/email_off-->
        </div>
      </div>
    </section>
  </main>
</Layout>
